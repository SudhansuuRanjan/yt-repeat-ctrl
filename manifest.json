{
  "manifest_version": 3,
  "name": "YouTube Repeat Controls",
  "version": "2.0",
  "description": "Adds repeat, A-B loop, sleep timer, and more to the YouTube player.",

  "permissions": ["storage"],

  "icons": {
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "100": "icons/icon100.png"
  },

  "action": {
    "default_icon": {
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "YouTube Repeat Controls"
  },

  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
